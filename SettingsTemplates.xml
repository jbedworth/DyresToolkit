<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
    <!-- The primer box (2.17.0): a settings row that says what a missing Dyre's
         AddOn would add to this page. Its height is fixed (the settings list
         reads it from the template), so a primer stays under about 400
         characters. DyresToolkitSettingsPrimerMixin is in Settings.lua. -->
    <Frame name="DyresToolkitSettingsPrimerTemplate" mixin="DyresToolkitSettingsPrimerMixin" virtual="true">
        <Size x="635" y="86"/>
        <Layers>
            <Layer level="BACKGROUND">
                <Texture parentKey="Background">
                    <Anchors>
                        <Anchor point="TOPLEFT" x="20" y="-4"/>
                        <Anchor point="BOTTOMRIGHT" x="-20" y="4"/>
                    </Anchors>
                    <Color r="0" g="0" b="0" a="0.4"/>
                </Texture>
            </Layer>
            <Layer level="BORDER">
                <Texture parentKey="Accent">
                    <Size x="3"/>
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Background"/>
                        <Anchor point="BOTTOMLEFT" relativeKey="$parent.Background"/>
                    </Anchors>
                    <Color r="1" g="0.82" b="0" a="0.9"/>
                </Texture>
            </Layer>
            <Layer level="ARTWORK">
                <FontString parentKey="Text" inherits="GameFontHighlight" justifyH="LEFT" justifyV="TOP">
                    <Anchors>
                        <Anchor point="TOPLEFT" relativeKey="$parent.Background" x="14" y="-10"/>
                        <Anchor point="BOTTOMRIGHT" relativeKey="$parent.Background" x="-14" y="8"/>
                    </Anchors>
                </FontString>
            </Layer>
        </Layers>
    </Frame>
</Ui>
